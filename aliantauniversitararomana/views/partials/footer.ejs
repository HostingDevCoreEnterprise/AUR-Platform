  <script>
    // Universal Modal Logic for Universities Page
    document.addEventListener('DOMContentLoaded', () => {
        const cards = document.querySelectorAll('.uni-card');
        const modal = document.getElementById('uniModal');
        if(cards.length > 0 && modal) {
            const overlay = document.querySelector('.modal-overlay');
            const closeBtn = document.querySelector('.modal-close');
            
            cards.forEach(card => {
                card.addEventListener('click', () => {
                    document.getElementById('modalLogo').src = card.dataset.logo;
                    document.getElementById('modalTitle').textContent = card.dataset.name;
                    document.getElementById('modalAbbr').textContent = card.dataset.abbr;
                    document.getElementById('modalLoc').textContent = card.dataset.loc;
                    document.getElementById('modalStuds').textContent = card.dataset.studs;
                    document.getElementById('modalWeb').textContent = card.dataset.web;
                    document.getElementById('modalWeb').href = 'https://' + card.dataset.web;
                    overlay.classList.add('active');
                });
            });

            closeBtn.addEventListener('click', () => overlay.classList.remove('active'));
            overlay.addEventListener('click', (e) => {
                if(e.target === overlay) overlay.classList.remove('active');
            });
        }
    });
  </script>
