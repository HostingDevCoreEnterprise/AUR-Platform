<style>
/* Hero Styles */
.hero {
    position: relative;
    overflow: hidden;
    padding: 80px 0;
}
.hero-bg-dynamic {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    z-index: -1;
}
.hero-bg-dynamic img {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    filter: brightness(0.2) grayscale(0.2);
    opacity: 0;
    animation: crossfade-hero 15s infinite;
}
.hero-bg-dynamic img:nth-child(1) { animation-delay: 0s; }
.hero-bg-dynamic img:nth-child(2) { animation-delay: 5s; }
.hero-bg-dynamic img:nth-child(3) { animation-delay: 10s; }

@keyframes crossfade-hero {
    0%, 10% { opacity: 1; }
    33%, 100% { opacity: 0; }
}

.hero .wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    position: relative;
    z-index: 2;
}

@media (max-width: 900px) {
    .hero .wrap { grid-template-columns: 1fr; }
}

.hero h1 {
    font-size: clamp(36px, 4vw, 54px);
    line-height: 1.2;
    margin-bottom: 24px;
    color: var(--tx-light);
}

.hero p {
    font-size: 18px;
    line-height: 1.6;
    color: var(--tx-light-mut);
    margin-bottom: 32px;
}

/* Stat Row */
.stat-row {
    display: flex;
    gap: 24px;
    margin-bottom: 32px;
    flex-wrap: wrap;
}
.stat-item {
    text-align: left;
}
.stat-num {
    font-size: 36px;
    font-weight: 700;
    color: var(--tx-light);
    line-height: 1;
}
.stat-label {
    font-size: 13px;
    color: var(--oxblood-l);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 4px;
}

/* Actions */
.hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
}
.btn-admitere {
    background: var(--oxblood-l);
    color: var(--tx-light);
    padding: 14px 28px;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    transition: filter 0.3s, transform 0.3s;
    font-size: 16px;
}
.btn-admitere:hover {
    filter: brightness(1.2);
    transform: translateY(-2px);
}
.btn-explore {
    background: transparent;
    color: var(--tx-light);
    padding: 14px 28px;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--line-d);
    transition: background 0.3s, border-color 0.3s;
    font-size: 16px;
}
.btn-explore:hover {
    background: rgba(255,255,255,0.05);
    border-color: var(--tx-light-mut);
}

/* Core Features */
.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 32px;
}
.feature-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--line-d);
    border-radius: 12px;
    padding: 32px;
    transition: transform 0.3s, border-color 0.3s;
}
.feature-card:hover {
    transform: translateY(-5px);
    border-color: var(--oxblood-l);
}
.feature-icon {
    font-size: 40px;
    margin-bottom: 24px;
    display: block;
}
.feature-card h3 {
    color: var(--tx-light);
    font-size: 20px;
    margin-bottom: 16px;
}
.feature-card p {
    color: var(--tx-light-mut);
    line-height: 1.6;
    margin-bottom: 0;
    font-size: 15px;
}

/* Navigare Rapida */
.nav-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 24px;
}
.nav-box {
    position: relative;
    height: 250px;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 24px;
}
.nav-box img {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    z-index: 1;
    transition: transform 0.5s;
}
.nav-overlay {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.2) 100%);
    z-index: 2;
    transition: background 0.3s;
}
.nav-box:hover img {
    transform: scale(1.05);
}
.nav-box:hover .nav-overlay {
    background: linear-gradient(to top, rgba(243,146,0,0.9) 0%, rgba(0,0,0,0.4) 100%);
}
.nav-content {
    position: relative;
    z-index: 3;
}
.nav-content h4 {
    color: var(--tx-light);
    font-size: 22px;
    margin: 0 0 8px 0;
}
.nav-content p {
    color: rgba(255,255,255,0.8);
    font-size: 14px;
    margin: 0 0 16px 0;
    line-height: 1.4;
}
.nav-action {
    color: var(--tx-light);
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Carousel Parteneri */
.carousel-container {
    overflow: hidden;
    white-space: nowrap;
    position: relative;
    padding: 40px 0;
    border-top: 1px solid var(--line-d);
    border-bottom: 1px solid var(--line-d);
    background: rgba(255,255,255,0.01);
}
.carousel-track {
    display: inline-block;
    animation: scroll-left 30s linear infinite;
}
.carousel-track:hover {
    animation-play-state: paused;
}
.carousel-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 40px;
    color: var(--tx-light-mut);
    font-size: 24px;
    font-weight: bold;
    letter-spacing: 2px;
    vertical-align: middle;
}

@keyframes scroll-left {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}

</style>

