<%- include('partials/header') %>

    <main class="container" style="max-width: 1000px; padding-top: 40px;">
        <div style="text-align: center; margin-bottom: 40px;">
            <span
                style="display: inline-block; background: rgba(236, 72, 153, 0.1); color: #ec4899; padding: 6px 16px; border-radius: 20px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 16px;">Hub-ul
                Extern</span>
            <h1 style="font-size: 36px; margin: 0 0 16px 0;">Master-List-ul Resurselor Oficiale</h1>
            <p
                style="color: var(--text-mut); font-size: 18px; margin: 0; max-width: 700px; margin-left: auto; margin-right: auto;">
                Platforma noastră nu reține informația pe care nu o deține. Aici sunt linkurile externe vitale pe care
                trebuie să le accesezi pentru decizii finale, toate adunate într-un singur loc.
            </p>
        </div>

        <!-- Tabel Hub -->
        
        <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 80px;">
            <div class="hub-list">
                <!-- 1 -->
                <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 1px solid var(--border-color); gap: 16px;">
                    <div style="flex: 1; min-width: 250px;">
                        <h3 style="margin: 0 0 8px 0; color: var(--text-main); font-size: 18px;">Baza de Date Oficială</h3>
                        <p style="margin: 0; color: var(--text-mut); font-size: 15px;">Oferă acces la toate facultățile de stat și private din țară, actualizate la zi de Guvernul României.</p>
                    </div>
                    <div>
                        <a href="https://studyinromania.gov.ro/" target="_blank" class="btn-outline-blue" style="display: inline-block; padding: 8px 16px; white-space: nowrap;">Study in Romania &nearr;</a>
                    </div>
                </div>
                <!-- 2 -->
                <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 1px solid var(--border-color); gap: 16px;">
                    <div style="flex: 1; min-width: 250px;">
                        <h3 style="margin: 0 0 8px 0; color: var(--text-main); font-size: 18px;">Legalitate & Anti-Țepe</h3>
                        <p style="margin: 0; color: var(--text-mut); font-size: 15px;">Previne înscrierea la facultăți „fantomă” ale căror diplome nu sunt recunoscute legal pe piața muncii.</p>
                    </div>
                    <div>
                        <a href="https://www.aracis.ro/" target="_blank" class="btn-outline-blue" style="display: inline-block; padding: 8px 16px; white-space: nowrap;">Registrul ARACIS &nearr;</a>
                    </div>
                </div>
                <!-- 3 -->
                <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 1px solid var(--border-color); gap: 16px;">
                    <div style="flex: 1; min-width: 250px;">
                        <h3 style="margin: 0 0 8px 0; color: var(--text-main); font-size: 18px;">Drepturi de Practică</h3>
                        <p style="margin: 0; color: var(--text-mut); font-size: 15px;">Leagă titlul abstract al facultății (ex: „Studii de securitate”) de funcția reală pe care o vei avea pe cartea de muncă.</p>
                    </div>
                    <div>
                        <a href="https://www.anc.edu.ro/" target="_blank" class="btn-outline-blue" style="display: inline-block; padding: 8px 16px; white-space: nowrap;">Codurile COR &nearr;</a>
                    </div>
                </div>
                <!-- 4 -->
                <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 1px solid var(--border-color); gap: 16px;">
                    <div style="flex: 1; min-width: 250px;">
                        <h3 style="margin: 0 0 8px 0; color: var(--text-main); font-size: 18px;">Salarii & Piața Muncii</h3>
                        <p style="margin: 0; color: var(--text-mut); font-size: 15px;">Spulberă iluziile. Află la ce salariu de pornire real (net) să te aștepți după absolvirea facultății alese.</p>
                    </div>
                    <div>
                        <a href="https://www.undelucram.ro/" target="_blank" class="btn-outline-blue" style="display: inline-block; padding: 8px 16px; white-space: nowrap;">Undelucram.ro &nearr;</a>
                    </div>
                </div>
                <!-- 5 -->
                <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 1px solid var(--border-color); gap: 16px;">
                    <div style="flex: 1; min-width: 250px;">
                        <h3 style="margin: 0 0 8px 0; color: var(--text-main); font-size: 18px;">Teste de Carieră</h3>
                        <p style="margin: 0; color: var(--text-mut); font-size: 15px;">Vital pentru tinerii din clasa a XII-a care nu știu dacă sunt construiți pentru Drept, Litere sau Inginerie.</p>
                    </div>
                    <div>
                        <a href="https://www.16personalities.com/" target="_blank" class="btn-outline-blue" style="display: inline-block; padding: 8px 16px; white-space: nowrap;">16Personalities &nearr;</a>
                    </div>
                </div>
                <!-- 6 -->
                <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 1px solid var(--border-color); gap: 16px;">
                    <div style="flex: 1; min-width: 250px;">
                        <h3 style="margin: 0 0 8px 0; color: var(--text-main); font-size: 18px;">Comunitate „Fără Filtru”</h3>
                        <p style="margin: 0; color: var(--text-mut); font-size: 15px;">Sursa numărul 1 de adevăr nescris despre restanțe, profesori abuzivi, taximetriști și condiții din cămine.</p>
                    </div>
                    <div>
                        <a href="https://www.reddit.com/r/UniRO/" target="_blank" class="btn-outline-blue" style="display: inline-block; padding: 8px 16px; white-space: nowrap;">Reddit UniRO &nearr;</a>
                    </div>
                </div>
                <!-- 7 -->
                <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 1px solid var(--border-color); gap: 16px;">
                    <div style="flex: 1; min-width: 250px;">
                        <h3 style="margin: 0 0 8px 0; color: var(--text-main); font-size: 18px;">Transport Subvenționat</h3>
                        <p style="margin: 0; color: var(--text-mut); font-size: 15px;">Cea mai căutată facilitate imediat după începerea anului universitar (reducere 90% la tren).</p>
                    </div>
                    <div>
                        <a href="https://www.cfrcalatori.ro/" target="_blank" class="btn-outline-blue" style="display: inline-block; padding: 8px 16px; white-space: nowrap;">Bilete CFR &nearr;</a>
                    </div>
                </div>
                <!-- 8 -->
                <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; padding: 24px; border-bottom: 1px solid var(--border-color); gap: 16px;">
                    <div style="flex: 1; min-width: 250px;">
                        <h3 style="margin: 0 0 8px 0; color: var(--text-main); font-size: 18px;">Imobiliare & Chirii</h3>
                        <p style="margin: 0; color: var(--text-mut); font-size: 15px;">Necesitatea principală a părinților pentru a stabili bugetul de mutare, dacă optezi să nu stai la cămin.</p>
                    </div>
                    <div>
                        <a href="https://www.storia.ro/" target="_blank" class="btn-outline-blue" style="display: inline-block; padding: 8px 16px; white-space: nowrap;">Storia.ro &nearr;</a>
                    </div>
                </div>
                <!-- 9 -->
                <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; padding: 24px; gap: 16px;">
                    <div style="flex: 1; min-width: 250px;">
                        <h3 style="margin: 0 0 8px 0; color: var(--text-main); font-size: 18px;">Drepturile Bobocului</h3>
                        <p style="margin: 0; color: var(--text-mut); font-size: 15px;">Regulamentele oficiale și Codul Drepturilor Studentului, explicate simplu de Alianța Națională a Studenților.</p>
                    </div>
                    <div>
                        <a href="https://www.anosr.ro/" target="_blank" class="btn-outline-blue" style="display: inline-block; padding: 8px 16px; white-space: nowrap;">ANOSR &nearr;</a>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>